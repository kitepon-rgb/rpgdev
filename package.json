{
  "name": "rpgdev",
  "version": "0.6.2",
  "description": "A small RPG overlay for Codex and Claude Code hook events (macOS, Windows, WSL2).",
  "license": "MIT",
  "author": "kitepon-rgb (https://github.com/kitepon-rgb)",
  "type": "module",
  "bin": {
    "rpgdev": "bin/rpgdev",
    "rpgdev-hook": "bin/rpgdev-hook",
    "rpgdev-server": "bin/rpgdev-server"
  },
  "scripts": {
    "start": "node scripts/desktop.mjs",
    "web": "node server/rpgdev-server.mjs --open",
    "server": "node server/rpgdev-server.mjs",
    "build:desktop": "node scripts/desktop.mjs --build-only",
    "render:bgm": "node scripts/render-bgm.mjs",
    "render:sfx": "node scripts/render-sfx.mjs",
    "demo": "node scripts/demo.mjs",
    "setup": "node scripts/rpg-setup.mjs",
    "trace": "node scripts/rpg-trace.mjs",
    "test": "node --test"
  },
  "files": [
    "bin",
    "desktop",
    "examples",
    "public",
    "scripts",
    "server",
    "test",
    "docs",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "claude-code",
    "hooks",
    "rpg",
    "overlay",
    "macos",
    "windows",
    "wsl"
  ],
  "homepage": "https://github.com/kitepon-rgb/rpgdev#readme",
  "bugs": {
    "url": "https://github.com/kitepon-rgb/rpgdev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitepon-rgb/rpgdev.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ]
}
